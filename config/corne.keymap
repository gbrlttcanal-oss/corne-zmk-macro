#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        m0: m0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N2 &kp N4 &kp N3 &kp N5 &kp N9 &kp N2>;
            label = "M0";
        };

        m1: m1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N8 &kp N6 &kp N6 &kp N2 &kp N1 &kp N1 &kp N0 &kp N9 &kp N8 &kp N3 &kp TAB &kp AT &kp O &kp LS(R) &kp N &kp N &kp J &kp Z &kp C &kp LS(K) &kp N9 &kp N &kp ENTER>;
            label = "M1";
        };

        m2: m2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp N0 &kp N8 &kp N6 &kp N6 &kp N2 &kp N1 &kp N1 &kp N0 &kp N9 &kp N8 &kp N3 &kp TAB &kp AT &kp K &kp N6 &kp LS(R) &kp W &kp N6 &kp K &kp Z &kp M &kp A &kp ENTER>;
            label = "M2";
        };

        m3: m3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp LC(B) &kp M &kp O &kp V &kp DOT &kp SPACE &kp LC(B) &kp RPAR &kp LEFT_ARROW>;
            label = "M3";
        };

        m4: m4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp DOT &kp DOT &kp DOT &kp RPAR>;
            label = "M4";
        };

        m5: m5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(E) &kp S &kp C &kp R &kp E &kp V &kp A &kp SPACE &kp M &kp E &kp L &kp H &kp O &kp R &kp COLON &kp RET &kp RET &kp LC(C)>;
            label = "M5";
        };

        m6: m6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp M &kp O &kp V &kp DOT &kp SPACE>;
            label = "M6";
        };

        m7: m7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "M7";
        };
    };

    behaviors {
        tapdance1: tapdance1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAPDANCE1";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp SPACE>, <&mo 3>;
        };

        tapdance2: tapdance2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAPDANCE2";
            #binding-cells = <0>;
            bindings = <&kp DEL>, <&kp ENTER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp GRAVE  &kp Q  &kp W  &kp E       &kp R  &kp T          &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D       &kp F  &kp G          &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C       &kp V  &kp B          &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                         &tapdance2  &mo 1  &lt 4 ENTER    &kp SPACE  &mo 2  &kp RALT
            >;
        };

        layer_1 {
            bindings = <
&m0     &m1     &m2     &trans  &trans  &m6       &trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &trans  &trans  &trans  &trans  &m3       &trans  &trans  &trans  &trans                &kp UP_ARROW           &trans
&trans  &trans  &trans  &trans  &trans  &m4       &trans  &trans  &trans  &kp LEFT_ARROW        &kp DOWN_ARROW         &kp RIGHT_ARROW
                        &trans  &trans  &trans    &trans  &mo 3   &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &none      &none   &kp CARET  &none   &none     &none   &none   &none   &none   &none   &kp MINUS
&none   &kp TILDE  &trans  &trans     &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans  &trans     &trans  &trans    &trans  &trans  &none   &none   &trans  &trans
                           &trans     &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT    &kp LCTRL  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSPACE
&trans  &trans           &trans       &trans    &trans      &trans         &trans     &trans         &trans        &trans                &trans                 &trans
&trans  &trans           &trans       &trans    &trans      &trans         &trans     &trans         &trans        &trans                &trans                 &trans
                                      &trans    &trans      &trans         &trans     &trans         &tapdance2
            >;
        };

        layer_4 {
            bindings = <
&trans          &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5    &kp NUMBER_6  &kp N7  &kp N8  &kp N9  &kp N0  &kp BACKSPACE
&kp LEFT_SHIFT  &trans        &trans        &trans        &trans        &trans    &trans        &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans    &trans        &trans  &trans  &trans  &trans  &trans
                                            &trans        &trans        &trans    &trans        &trans  &trans
            >;
        };
    };
};
